# Скопируй этот файл в .env и заполни реальными значениями
# cp .env.example .env

# Токен бота от @BotFather
BOT_TOKEN=

# Твой Telegram user_id (узнать через @userinfobot)
ELENA_TG_USER_ID=

# YooKassa (подключается в BotFather как Payments Provider)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/kouch_catalog

# Публичный HTTPS-адрес сервера для Telegram webhook
WEBHOOK_URL=https://yourdomain.com/bot/webhook
